  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3200",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3200",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:validate && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "qrcode": "1.5.4",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "node": "24.22.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
