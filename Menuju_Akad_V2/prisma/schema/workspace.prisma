enum WorkspaceRole {  
  OWNER  
  PARTNER  
} 
  
enum WorkspaceStatus {  
  ACTIVE  
  ARCHIVED  
  SUSPENDED  
} 
  
model Workspace {  
  id          String         @id @default(cuid())  
  name        String  
  slug        String         @unique  
  status      WorkspaceStatus @default(ACTIVE)  
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)  
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3) 
  members     Membership[]  
  events      Event[]  
  invitations Invitation[]  
  tasks       Task[]  
  calendarEvents CalendarEvent[]  
  rundowns    Rundown[]  
  checklists  Checklist[]  
  budgets     BudgetCategory[]  
  expenses    Expense[]  
  vendors     VendorRequest[]  
  guests      Guest[]  
  documents   KuaDocument[]  
  reviews     Review[]  
  notifications Notification[]  
  auditLogs   AuditLog[]  
} 
  
model Membership {  
  id          String         @id @default(cuid())  
  workspaceId String  
  userId      String  
  role        WorkspaceRole  
  joinedAt    DateTime       @default(now()) @db.Timestamptz(3)  
  
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)  
  
  @@unique([workspaceId, userId])  
  @@index([userId])  
} 
  
model Event {  
  id          String   @id @default(cuid())  
  workspaceId String  
  name        String  
  date        DateTime? @db.Timestamptz(3)  
  location    String?  
  type        String?  
  createdAt   DateTime @default(now()) @db.Timestamptz(3)  
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)  
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  invitations Invitation[]  
  guests      Guest[]  
  tasks       Task[]  
  calendarEvents CalendarEvent[]  
  rundowns    Rundown[]  
  expenses    Expense[]  
  documents   KuaDocument[]  
  
  @@index([workspaceId])  
} 
  
 
 
enum InvitationStatus {  
  DRAFT  
  PUBLISHED  
  EXPIRED  
} 
  
model Invitation {  
  id             String            @id @default(cuid())  
  workspaceId    String  
  eventId        String  
  slug           String            @unique  
  title          String  
  description    String?  
  templateId     String?  
  status         InvitationStatus  @default(DRAFT)  
  publishedAt    DateTime?         @db.Timestamptz(3)  
  expiresAt      DateTime?         @db.Timestamptz(3)  
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)  
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)  
  
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)  
  guests         Guest[]  
  rsvps          RSVP[]  
  template       InvitationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)  
} 
enum RSVPStatus {  
  PENDING  
  CONFIRMED  
  DECLINED  
} 
  
model Guest {  
  id             String     @id @default(cuid())  
  workspaceId    String  
  eventId        String?  
  invitationId   String?  
  name           String  
  phone          String?  
  email          String?  
  side           String?   
  category       String?   
  dietary        String?   
  tableNumber    Int?      
  seatNumber     Int?      
  plusOne        Int      @default(0)  
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)  
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)  
  
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)  
  invitation     Invitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)  
  rsvps          RSVP[]        
} 
  
model RSVP {  
  id             String     @id @default(cuid())  
  invitationId   String  
  guestId        String  
  status         RSVPStatus @default(PENDING)  
  respondedAt    DateTime?  @db.Timestamptz(3)  
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)  
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)  
  
  invitation     Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)  
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)  
  
  @@unique([invitationId, guestId])  
} 
enum TaskStatus {  
  TODO  
  IN_PROGRESS  
  DONE  
} 
  
model Task {  
  id          String     @id @default(cuid())  
  workspaceId   String  
  eventId       String?  
  title         String  
  description   String?  
  status        TaskStatus @default(TODO)  
  priority      Int      @default(0)  
  dueDate       DateTime?  @db.Timestamptz(3)  
  assigneeId    String?   
  parentId      String?   
  order         Int      @default(0)  
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)  
  assignee      User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)  
  parent        Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks      Task[]       @relation("TaskSubtasks") 
  @@index([workspaceId, status])  
  @@index([eventId, status])  
  @@index([assigneeId])
}

enum CalendarEventStatus {
  SCHEDULED
  DONE
  CANCELLED
}

model CalendarEvent {
  id          String   @id @default(cuid())
  workspaceId String
  eventId     String?
  title       String
  description String?
  startAt     DateTime @db.Timestamptz(3)
  endAt       DateTime? @db.Timestamptz(3)
  location    String?
  status      CalendarEventStatus @default(SCHEDULED)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
}
  
enum RundownStatus {  
  DRAFT  
  PUBLISHED  
  ARCHIVED  
} 
  
model Rundown {  
  id            String         @id @default(cuid())  
  workspaceId   String  
  eventId       String?  
  title         String  
  description   String?  
  status        RundownStatus  @default(DRAFT)  
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)  
  items         RundownItem[]  
  
  @@index([workspaceId])  
  @@index([eventId])  
} 
  
model RundownItem {  
  id            String         @id @default(cuid())  
  rundownId     String  
  title         String  
  description   String?  
  startTime     DateTime?      @db.Timestamptz(3)  
  endTime       DateTime?      @db.Timestamptz(3)  
  order         Int            @default(0)  
  responsible   String?  
  notes         String?  
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)  
  
  rundown       Rundown        @relation(fields: [rundownId], references: [id], onDelete: Cascade)  
  
  @@index([rundownId, order])  
} 
  
enum ChecklistStatus {  
  PENDING  
  IN_PROGRESS  
  COMPLETED  
  SKIPPED  
}  
  
model Checklist {  
  id            String         @id @default(cuid())  
  workspaceId   String  
  name          String  
  description   String?  
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  items         ChecklistItem[]  
  
  @@index([workspaceId])  
} 
  
model ChecklistItem {  
  id            String           @id @default(cuid())  
  checklistId   String  
  title         String  
  description   String?  
  status        ChecklistStatus  @default(PENDING)  
  order         Int              @default(0)  
  dueDate       DateTime?        @db.Timestamptz(3)  
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)  
  
  checklist     Checklist        @relation(fields: [checklistId], references: [id], onDelete: Cascade)  
  
  @@index([checklistId, order])  
} 
  
enum BudgetCategoryType {  
  BUDGET  
  SAVINGS  
  EXPENSE  
}  
  
model BudgetCategory {  
  id            String             @id @default(cuid())  
  workspaceId   String  
  name          String  
  type          BudgetCategoryType @default(BUDGET)  
  amount        Decimal            @db.Decimal(15, 2)  
  spent         Decimal            @default(0) @db.Decimal(15, 2)  
  color         String?  
  icon          String?  
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  expenses      Expense[]  
  
  @@index([workspaceId])  
} 
  
model Expense {  
  id              String          @id @default(cuid())  
  workspaceId     String  
  eventId         String?  
  categoryId      String?  
  amount          Decimal         @db.Decimal(15, 2)  
  description     String?  
  date            DateTime        @db.Timestamptz(3)  
  vendor          String?  
  receiptUrl      String?  
  isPaid          Boolean         @default(false)  
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)  
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)  
  
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)  
  category        BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)  
  
  @@index([workspaceId, date])  
  @@index([categoryId])  
} 
  
enum VendorRequestStatus {  
  PENDING  
  QUOTED  
  ACCEPTED  
  REJECTED  
  COMPLETED  
}  
  
model VendorRequest {  
  id            String               @id @default(cuid())  
  workspaceId   String  
  eventId       String?  
  vendorId      String?  
  vendorName    String  
  vendorEmail   String?  
  vendorPhone   String?  
  serviceType   String  
  description   String?  
  budget        Decimal?             @db.Decimal(15, 2)  
  status        VendorRequestStatus  @default(PENDING)  
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  
  @@index([workspaceId, status])  
} 
  
enum ReviewStatus {  
  PENDING  
  APPROVED  
  REJECTED  
}  
  
model Review {  
  id            String       @id @default(cuid())  
  workspaceId   String  
  userId        String  
  rating        Int  
  title         String?  
  content       String  
  status        ReviewStatus @default(PENDING)  
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)  
  
  @@index([status])  
  @@index([workspaceId])  
} 
  
model InvitationTemplate {  
  id            String      @id @default(cuid())  
  name          String  
  description   String?  
  thumbnailUrl  String?  
  category      String?  
  isActive      Boolean     @default(true)  
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)  
  
  invitations   Invitation[]  
} 
  
enum KuaDocumentStatus {  
  DRAFT  
  IN_PROGRESS  
  COMPLETED  
  EXPORTED  
}  
  
model KuaDocument {  
  id            String            @id @default(cuid())  
  workspaceId   String  
  eventId       String?  
  title         String  
  type          String  
  status        KuaDocumentStatus @default(DRAFT)  
  content       Json?  
  fileUrl       String?  
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)  
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)  
  
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)  
  
  @@index([workspaceId, status])  
} 
  
enum NotificationChannel {  
  EMAIL  
  SMS  
  WHATSAPP  
  IN_APP  
}  
enum NotificationStatus {  
  PENDING  
  SENT  
  DELIVERED  
  FAILED  
  READ  
}  
  
model Notification {  
  id            String             @id @default(cuid())  
  workspaceId   String  
  userId        String?  
  title         String  
  body          String  
  channel       NotificationChannel @default(IN_APP)  
  status        NotificationStatus @default(PENDING)  
  data          Json?  
  readAt        DateTime?          @db.Timestamptz(3)  
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)  
  
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)  
  
  @@index([workspaceId, createdAt])  
  @@index([userId, status])  
} 
  
enum AuditAction {  
  CREATE  
  UPDATE  
  DELETE  
  VIEW  
  LOGIN  
  LOGOUT  
  EXPORT  
}  
  
model AuditLog {  
  id            String       @id @default(cuid())  
  workspaceId   String?  
  userId        String?  
  action        AuditAction  
  entity        String  
  entityId      String?  
  oldValue      Json?  
  newValue      Json?  
  ipAddress     String?  
  userAgent     String?  
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)  
  
  workspace     Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)  
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)  
  
  @@index([workspaceId, createdAt])  
  @@index([userId, createdAt])  
  @@index([entity, entityId])  
} 

