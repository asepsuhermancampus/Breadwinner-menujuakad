UI_PREVIEW_ENABLED=false
DATABASE_URL=
DIRECT_URL=

# Auth.js / Google OAuth (Authorized redirect URI: http://localhost:3201/api/auth/callback/google)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public application URL. Set to https://your-domain.example when deploying behind a proxy.
# Registration, sign-in and invitation links use this trusted application origin.
AUTH_URL=http://localhost:3201
# Canonical accounts and revocable sessions. Empty uses .data/auth.sqlite.
AUTH_DATABASE_PATH=

# KlikQRIS Payment Gateway
# KLIKQRIS_ENV can be "production" or "sandbox". Note: sandbox requires its own separate sandbox credentials.
# KLIKQRIS_CALLBACK_URL must be a public HTTPS endpoint accessible by KlikQRIS webhook servers (use tunnel for local dev).
KLIKQRIS_ENV=production
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
KLIKQRIS_CALLBACK_URL=

# Optional persistent SQLite path. Leave blank for .data/klikqris.sqlite.
# Browser tests use a separate temporary database via this variable.
PAYMENT_DATABASE_PATH=
# Exact comma-separated Google emails allowed to view the real support queue.
# Empty means no operations access. Never put this list in NEXT_PUBLIC_*.
OPERATIONS_EMAIL_ALLOWLIST=
